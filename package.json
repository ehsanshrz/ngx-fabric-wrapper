{
  "name": "ngx-fabric-wrapper",
  "description": "Angular wrapper library for Fabric",
  "bugs": "https://github.com/zefoy/ngx-fabric-wrapper/issues",
  "version": "17.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "start": "ng serve app",
    "build": "ng build lib",
    "prepare": "ng build lib --configuration production",
    "publish": "npm publish ./dist/lib",
    "predeploy": "rimraf ./dist/app && mkdirp ./dist/app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zefoy/ngx-fabric-wrapper.git"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/platform-browser-dynamic": "^22.0.5",
    "fabric": "^7.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular-eslint/builder": "^22.0.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/eslint-plugin-template": "^22.0.0",
    "@angular-eslint/schematics": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "mkdirp": "^3.0.1",
    "ng-packagr": "^22.0.1",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-order": "^6.0.0",
    "typescript": "~6.0.3",
    "zone.js": "~0.16.2"
  }
}
